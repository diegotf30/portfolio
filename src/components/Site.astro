---
import Layout from '../layouts/Layout.astro';
import { content, type Lang } from '../i18n';
import { icons, viewBox } from '../icons';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const home = lang === 'es' ? '/es/' : '/';

const marquee = [
  'C++20', 'Ruby on Rails', 'Spanner', 'LLVM', 'gRPC', 'Kubernetes',
  'PostgreSQL', 'Bazel', 'Docker', 'GCP', 'Hotwire', 'Astro', 'Python',
  'Node.js', 'React', 'AWS', 'MongoDB', 'Heroku', 'Kamal', 'Go',
];
---

<Layout lang={lang}>
  <nav class="nav glass">
    <a class="nav-brand" href={home}>diego<span>.tf</span></a>
    <div class="nav-links">
      <a href="#work">{t.nav.work}</a>
      <a href="#about">{t.nav.about}</a>
      <a href="#experience">{t.nav.experience}</a>
      <a href="#contact">{t.nav.contact}</a>
    </div>
    <div class="lang" data-lang={lang}>
      <a href="/" aria-current={lang === 'en'} hreflang="en">EN</a>
      <a href="/es/" aria-current={lang === 'es'} hreflang="es">ES</a>
    </div>
  </nav>

  <header class="hero">
    <div class="wrap hero-grid">
      <h1>
        {t.hero.title.map((line) => (
          <span class="line"><span>{line}</span></span>
        ))}
      </h1>

      <div class="hero-copy">
      <p class="hero-role reveal">{t.hero.role}</p>
      <p class="hero-lede reveal" style="--d:.06s">
        {t.hero.lede.map((line, i) => (
          <>{i > 0 && ' '}<span>{line}</span></>
        ))}
      </p>
      <p class="hero-meta reveal" style="--d:.12s"><span class="dot"></span>{t.hero.location}</p>
      <div class="hero-cta reveal" style="--d:.18s">
        <a class="btn btn-primary" href="#work">
          {t.hero.cta}<span class="arrow">→</span>
        </a>
        <a class="btn btn-ghost" href={`mailto:${t.contact.email}`}>{t.hero.ctaAlt}</a>
      </div>
      </div>

      <div class="terminal glass" aria-hidden="true">
        <div class="term-bar"><i></i><i></i><i></i><span>~/diego.tf</span></div>
        <pre class="term-body">{/* ghost reserves the exact height so typing never reflows the hero */}
<code class="term-ghost">$ whoami
diego treviño — software engineer
$ stack --top
c++20 · rails · postgres · k8s
$ ls projects/
renovacreto  lab404  zanzibar  llvm-reduce
$ status
available for work → hola@diego.tf</code><code id="term"></code></pre>
      </div>
    </div>
  </header>


  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="marquee-row">
          {marquee.map((m) => (
            <><span>{m}</span><i>◆</i></>
          ))}
        </div>
      ))}
    </div>
  </div>

  <section id="work">
    <div class="wrap">
      <div class="reveal">
        <div class="kicker">{t.work.kicker}</div>
        <h2 class="section-title">{t.work.title}</h2>
      </div>
      <div class="work-grid">
        {t.work.items.map((p, i) => (
          <article class="card glass reveal" style={`--d:${(i % 2) * 0.09}s`}>
            <div class="card-top">
              <span>{p.type}</span>
              <span>{p.year}</span>
            </div>
            <h3>{p.name}</h3>
            <p>{p.summary}</p>
            {p.links.length > 0 && (
              <div class="card-links">
                {p.links.map((l) => (
                  <a class="card-link" href={l.href} target="_blank" rel="noopener noreferrer">
                    {l.label}<span class="arrow">↗</span>
                  </a>
                ))}
              </div>
            )}
            <div class="tags">
              {p.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <div class="reveal">
        <div class="kicker">{t.about.kicker}</div>
        <h2 class="section-title">{t.about.title}</h2>
      </div>
      <div class="about-grid">
        <div class="prose glass reveal">
          {t.about.body.map((para) => (
            <p>{para}</p>
          ))}
        </div>
        <div class="skills glass reveal" style="--d:.09s">
          <h3>{t.about.skills.title}</h3>
          {t.about.skills.groups.map((g) => (
            <div class="skill-group">
              <div>{g.label}</div>
              <div class="tags" style="margin-top:0;padding-top:0">
                {g.items.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </div>
            </div>
          ))}
          <div class="langs">
            <div class="langs-title">{t.about.languages.title}</div>
            <div class="langs-row">
              {t.about.languages.items.map((l) => (
                <div class="lang-chip">
                  <span class="n">{l.name}</span>
                  <span class="lv">{l.level}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="wrap">
      <div class="reveal">
        <div class="kicker">{t.experience.kicker}</div>
        <h2 class="section-title">{t.experience.title}</h2>
      </div>
      <div class="timeline">
        {t.experience.items.map((job) => (
          <article class="job glass reveal">
            <div class="job-head">
              <span class={`job-icon i-${job.icon}`} aria-hidden="true">
                <svg viewBox={viewBox[job.icon] ?? '0 0 24 24'} fill="currentColor" set:html={icons[job.icon]} />
              </span>
              <h3>{job.role}</h3>
              <div class="org">{job.org}</div>
              <div class="period">{job.period}</div>
              {job.place && <div class="place">{job.place}</div>}
            </div>
            <ul>
              {job.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </article>
        ))}
        <div class="edu glass reveal">
          <span class="edu-icon" aria-hidden="true">
            <svg viewBox={viewBox.itesm} fill="currentColor" set:html={icons.itesm} />
          </span>
          <div class="t">{t.experience.education.title}</div>
          <div class="d">{t.experience.education.degree}</div>
          <div class="s">{t.experience.education.school}</div>
          <div class="m">{t.experience.education.detail}</div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <div class="contact-card glass reveal">
        <div class="kicker" style="margin-bottom:0">{t.contact.kicker}</div>
        <h2>{t.contact.title}</h2>
        <p>{t.contact.body}</p>
        <a class="mail" href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
        <div class="social">
          {t.contact.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              <svg class={`social-icon i-${l.icon}`} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons[l.icon]} />
              {l.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap">© {new Date().getFullYear()} Diego Treviño</div>
  </footer>
</Layout>
