---
import LayoutFlat from '../layouts/LayoutFlat.astro';
import { content, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const home = lang === 'es' ? '/es/b/' : '/b/';
---

<LayoutFlat lang={lang}>
  <nav class="nav">
    <div class="wrap nav-inner">
      <a class="nav-brand" href={home}>diego<span>.tf</span></a>
      <div class="nav-links">
        <a href="#work">{t.nav.work}</a>
        <a href="#about">{t.nav.about}</a>
        <a href="#experience">{t.nav.experience}</a>
        <a href="#contact">{t.nav.contact}</a>
      </div>
      <div class="lang">
        <a href="/b/" aria-current={lang === 'en'} hreflang="en">EN</a>
        <a href="/es/b/" aria-current={lang === 'es'} hreflang="es">ES</a>
      </div>
    </div>
  </nav>

  <header class="hero">
    <!-- potted monstera -->
    <div class="art a-monstera" aria-hidden="true">
      <svg viewBox="0 0 260 320">
        <defs>
          <linearGradient id="potG" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#d79a72" />
            <stop offset="1" stop-color="#b9714a" />
          </linearGradient>
          <linearGradient id="leafG" x1="0" y1="0" x2=".6" y2="1">
            <stop offset="0" stop-color="#93ab7a" />
            <stop offset="1" stop-color="#6d8659" />
          </linearGradient>
        </defs>

        <!-- stems -->
        <g stroke="#7d9469" stroke-width="7" stroke-linecap="round" fill="none">
          <path d="M130 250c-4-40-22-62-44-80" />
          <path d="M130 250c2-44 16-66 40-84" />
          <path d="M130 252c0-42 2-70 2-96" />
        </g>

        <!-- leaves: rounded blades, notches punched with background-coloured circles -->
        <g class="leaf l-a" transform="translate(78 150) rotate(-22)">
          <ellipse rx="46" ry="60" fill="url(#leafG)" />
          <ellipse cx="-12" cy="-20" rx="16" ry="26" fill="#a0b787" opacity=".55" />
          <circle cx="-46" cy="-16" r="13" fill="var(--cream)" />
          <circle cx="-46" cy="20" r="13" fill="var(--cream)" />
          <circle cx="46" cy="-4" r="12" fill="var(--cream)" />
          <circle cx="46" cy="32" r="11" fill="var(--cream)" />
          <path d="M0 54V-50" stroke="#5f7650" stroke-width="3" stroke-linecap="round" opacity=".5" />
        </g>

        <g class="leaf l-b" transform="translate(178 138) rotate(20)">
          <ellipse rx="44" ry="58" fill="url(#leafG)" />
          <ellipse cx="-10" cy="-18" rx="15" ry="24" fill="#a0b787" opacity=".5" />
          <circle cx="-44" cy="-12" r="12" fill="var(--cream)" />
          <circle cx="-44" cy="24" r="12" fill="var(--cream)" />
          <circle cx="44" cy="-20" r="12" fill="var(--cream)" />
          <circle cx="44" cy="16" r="12" fill="var(--cream)" />
          <path d="M0 52V-48" stroke="#5f7650" stroke-width="3" stroke-linecap="round" opacity=".5" />
        </g>

        <g class="leaf l-c" transform="translate(132 88)">
          <ellipse rx="40" ry="52" fill="#84a06c" />
          <ellipse cx="-10" cy="-16" rx="14" ry="22" fill="#a0b787" opacity=".5" />
          <circle cx="-40" cy="-10" r="11" fill="var(--cream)" />
          <circle cx="-40" cy="22" r="11" fill="var(--cream)" />
          <circle cx="40" cy="-10" r="11" fill="var(--cream)" />
          <circle cx="40" cy="22" r="11" fill="var(--cream)" />
          <path d="M0 46V-44" stroke="#5f7650" stroke-width="3" stroke-linecap="round" opacity=".5" />
        </g>

        <!-- pot -->
        <ellipse cx="130" cy="308" rx="72" ry="11" fill="#2b2318" opacity=".13" />
        <ellipse cx="130" cy="250" rx="58" ry="12" fill="#5d4736" />
        <path d="M74 248h112l-12 54c-1 9-9 16-18 16h-52c-9 0-17-7-18-16z" fill="url(#potG)" />
        <path d="M162 248h24l-12 54c-1 9-9 16-18 16h-14c9 0 16-7 17-16z" fill="#a9663f" opacity=".55" />
        <rect x="64" y="232" width="132" height="30" rx="15" fill="#dda57c" />
        <rect x="64" y="250" width="132" height="12" rx="6" fill="#b9714a" opacity=".35" />
      </svg>
    </div>

    <!-- hanging pothos -->
    <div class="art a-pothos" aria-hidden="true">
      <svg viewBox="0 0 200 400">
        <defs>
          <linearGradient id="hangG" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#e0ab86" />
            <stop offset="1" stop-color="#bd7850" />
          </linearGradient>
        </defs>

        <g stroke="#8fa678" stroke-width="4" fill="none" stroke-linecap="round">
          <path d="M78 96c-14 40-6 78-22 118s-10 74 4 96" />
          <path d="M122 96c12 44 2 80 16 118s6 62-8 82" />
        </g>

        <g fill="#7d9469">
          <ellipse cx="62" cy="152" rx="17" ry="13" transform="rotate(-18 62 152)" />
          <ellipse cx="88" cy="196" rx="16" ry="12" transform="rotate(14 88 196)" />
          <ellipse cx="52" cy="236" rx="18" ry="13" transform="rotate(-22 52 236)" />
          <ellipse cx="74" cy="286" rx="16" ry="12" transform="rotate(10 74 286)" />
          <ellipse cx="58" cy="330" rx="15" ry="11" transform="rotate(-14 58 330)" />
          <ellipse cx="140" cy="150" rx="17" ry="13" transform="rotate(16 140 150)" />
          <ellipse cx="152" cy="200" rx="16" ry="12" transform="rotate(-12 152 200)" />
          <ellipse cx="136" cy="248" rx="18" ry="13" transform="rotate(20 136 248)" />
          <ellipse cx="150" cy="296" rx="15" ry="11" transform="rotate(-8 150 296)" />
        </g>
        <g fill="#a0b787" opacity=".55">
          <ellipse cx="58" cy="148" rx="7" ry="5" />
          <ellipse cx="84" cy="192" rx="6" ry="4" />
          <ellipse cx="48" cy="232" rx="7" ry="5" />
          <ellipse cx="136" cy="146" rx="7" ry="5" />
          <ellipse cx="148" cy="196" rx="6" ry="4" />
        </g>

        <!-- hanger + pot -->
        <path d="M100 8v26" stroke="#c9b8a2" stroke-width="4" fill="none" />
        <path d="M100 30 62 74M100 30l38 44" stroke="#c9b8a2" stroke-width="4" fill="none" />
        <path d="M60 72h80l-9 40c-2 10-10 17-20 17H89c-10 0-18-7-20-17z" fill="url(#hangG)" />
        <path d="M120 72h20l-9 40c-2 10-10 17-20 17h-12c10 0 18-7 20-17z" fill="#a9663f" opacity=".5" />
        <rect x="52" y="60" width="96" height="24" rx="12" fill="#e6b18c" />
      </svg>
    </div>

    <!-- sitting cat -->
    <div class="art a-cat-sit" aria-hidden="true">
      <svg viewBox="0 0 180 214">
        <ellipse cx="92" cy="209" rx="62" ry="8" fill="#2b2318" opacity=".12" />
        <path
          class="cat-tail"
          d="M142 190c26 2 34-14 28-30-6-15-22-18-30-8"
          stroke="#e3d3ba"
          stroke-width="17"
          stroke-linecap="round"
          fill="none"
        />
        <g class="cat-body">
          <path d="M90 204c-38 0-58-15-58-42 0-33 20-68 58-68s58 35 58 68c0 27-20 42-58 42z" fill="#efe1cc" />
          <path d="M90 204c-11 0-21-1-29-4 10-24 12-52 8-84 6-2 13-3 21-3 38 0 58 35 58 68 0 27-20 23-58 23z" fill="#ddc9a9" opacity=".55" />
          <ellipse cx="90" cy="172" rx="26" ry="20" fill="#f7ecdc" />
          <ellipse cx="66" cy="196" rx="15" ry="10" fill="#f7ecdc" />
          <ellipse cx="114" cy="196" rx="15" ry="10" fill="#f7ecdc" />

          <path d="M56 52c-2-16 2-24 6-24s16 10 22 20z" fill="#efe1cc" />
          <path d="M124 52c2-16-2-24-6-24s-16 10-22 20z" fill="#efe1cc" />
          <path d="M60 48c-1-9 1-14 3-14s8 6 12 12z" fill="#e5a795" />
          <path d="M120 48c1-9-1-14-3-14s-8 6-12 12z" fill="#e5a795" />
          <circle cx="90" cy="74" r="42" fill="#efe1cc" />
          <path d="M90 32c-14 0-26 5-33 14 12 5 25 7 39 6 12-1 20-4 25-7-8-8-19-13-31-13z" fill="#ddc9a9" opacity=".5" />
          <ellipse cx="76" cy="72" rx="4.5" ry="5.5" fill="#574636" />
          <ellipse cx="104" cy="72" rx="4.5" ry="5.5" fill="#574636" />
          <ellipse cx="66" cy="84" rx="7" ry="4.5" fill="#e5a795" opacity=".65" />
          <ellipse cx="114" cy="84" rx="7" ry="4.5" fill="#e5a795" opacity=".65" />
          <path d="M90 84l-4.5 4h9z" fill="#c98878" />
          <path d="M84 92c2 3 10 3 12 0" stroke="#574636" stroke-width="2.4" fill="none" stroke-linecap="round" />
          <g stroke="#c9b8a0" stroke-width="2" stroke-linecap="round">
            <path d="M54 78H36M54 86l-17 5M126 78h18M126 86l17 5" />
          </g>
        </g>
      </svg>
    </div>

    <div class="wrap hero-copy">
      <div class="badge">
        <span class="dot"></span>
        {t.hero.badge}
      </div>
      <h1>
        {t.hero.title.map((line) => (
          <span class="line"><span>{line}</span></span>
        ))}
      </h1>
      <p class="hero-role reveal">{t.hero.role}</p>
      <p class="hero-lede reveal" style="--d:.06s">{t.hero.lede}</p>
      <p class="hero-meta reveal" style="--d:.12s">{t.hero.location}</p>
      <div class="hero-cta reveal" style="--d:.18s">
        <a class="btn btn-primary" href="#work">
          {t.hero.cta}<span class="arrow">→</span>
        </a>
        <a class="btn btn-ghost" href={`mailto:${t.contact.email}`}>{t.hero.ctaAlt}</a>
      </div>
    </div>
  </header>

  <section style="padding-top:0">
    <div class="wrap stats">
      {t.stats.map((s, i) => (
        <div class="stat reveal" style={`--d:${i * 0.07}s`}>
          <div class="v">{s.value}</div>
          <div class="l">{s.label}</div>
          <div class="n">{s.note}</div>
        </div>
      ))}
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="reveal">
        <div class="kicker">{t.work.kicker}</div>
        <h2 class="section-title">{t.work.title}</h2>
      </div>
      <div class="work-grid">
        {t.work.items.map((p, i) => (
          <article class="card reveal" style={`--d:${(i % 2) * 0.09}s`}>
            <div class="card-top">
              <span>{p.type}</span>
              <span>{p.year}</span>
            </div>
            <h3>{p.name}</h3>
            <p>{p.summary}</p>
            {p.link && (
              <a class="card-link" href={p.link} target="_blank" rel="noopener noreferrer">
                {p.linkLabel}<span class="arrow">↗</span>
              </a>
            )}
            <div class="tags">
              {p.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <div class="reveal">
        <div class="kicker">{t.about.kicker}</div>
        <h2 class="section-title">{t.about.title}</h2>
      </div>
      <div class="about-grid">
        <div class="prose reveal">
          {t.about.body.map((para) => (
            <p>{para}</p>
          ))}
        </div>
        <div class="skills reveal" style="--d:.09s">
          <h3>{t.about.skills.title}</h3>
          {t.about.skills.groups.map((g) => (
            <div class="skill-group">
              <div>{g.label}</div>
              <div class="tags" style="margin-top:0;padding-top:0">
                {g.items.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="wrap">
      <div class="reveal">
        <div class="kicker">{t.experience.kicker}</div>
        <h2 class="section-title">{t.experience.title}</h2>
      </div>
      <div class="timeline">
        {t.experience.items.map((job) => (
          <article class="job reveal">
            <div class="job-head">
              <h3>{job.role}</h3>
              <div class="org">{job.org}</div>
              <div class="period">{job.period} · {job.place}</div>
            </div>
            <ul>
              {job.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </article>
        ))}
        <div class="edu reveal">
          <div class="t">{t.experience.education.title}</div>
          <div class="d">{t.experience.education.degree}</div>
          <div class="s">{t.experience.education.school}</div>
          <div class="m">{t.experience.education.detail}</div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <div class="contact-card reveal">
        <!-- sleeping cat -->
        <div class="art a-cat-sleep" aria-hidden="true">
          <svg viewBox="0 0 220 140">
            <ellipse cx="110" cy="132" rx="88" ry="9" fill="#2b2318" opacity=".16" />
            <g class="cat-body">
              <path
                d="M40 130c-22 0-32-16-32-36 0-32 32-56 78-56s86 20 86 50c0 26-18 42-52 42z"
                fill="#e8dac2"
              />
              <path
                d="M60 130c34 0 62-14 66-40 2-14-4-27-16-36 14 6 26 17 30 30 8 26-10 46-48 46z"
                fill="#d3bf9f"
                opacity=".6"
              />
              <path
                class="cat-tail"
                d="M40 122c-18 6-24-6-18-18 6-13 26-18 44-14"
                stroke="#e8dac2"
                stroke-width="18"
                stroke-linecap="round"
                fill="none"
              />
              <circle cx="158" cy="80" r="38" fill="#eddfc8" />
              <path d="M132 50c-4-14-1-21 3-21s13 8 18 16z" fill="#eddfc8" />
              <path d="M186 52c5-13 3-21-1-22s-14 6-19 13z" fill="#eddfc8" />
              <path d="M136 47c-2-8 0-12 2-12s7 5 10 10z" fill="#e5a795" />
              <path d="M182 49c3-8 2-12 0-12s-7 4-10 9z" fill="#e5a795" />
              <path d="M142 78c3 4 9 4 12 0" stroke="#574636" stroke-width="2.6" fill="none" stroke-linecap="round" />
              <path d="M168 78c3 4 9 4 12 0" stroke="#574636" stroke-width="2.6" fill="none" stroke-linecap="round" />
              <ellipse cx="138" cy="90" rx="7" ry="4.5" fill="#e5a795" opacity=".7" />
              <ellipse cx="182" cy="90" rx="7" ry="4.5" fill="#e5a795" opacity=".7" />
              <path d="M160 88l-4 4h8z" fill="#c98878" />
            </g>
            <g fill="#f5ece0" opacity=".85" font-family="system-ui" font-weight="700">
              <text x="196" y="34" font-size="18">z</text>
              <text x="210" y="18" font-size="13">z</text>
            </g>
          </svg>
        </div>
        <div class="kicker">{t.contact.kicker}</div>
        <h2>{t.contact.title}</h2>
        <p>{t.contact.body}</p>
        <a class="mail" href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
        <div class="social">
          {t.contact.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <footer>
    <!-- loaf cat -->
    <div class="art a-cat-loaf" aria-hidden="true">
      <svg viewBox="0 0 180 132">
        <ellipse cx="90" cy="124" rx="66" ry="8" fill="#2b2318" opacity=".12" />
        <g class="cat-body">
          <path d="M90 124c-44 0-66-14-66-42 0-30 30-52 66-52s66 22 66 52c0 28-22 42-66 42z" fill="#d8cbb6" />
          <path d="M90 124c30 0 50-8 60-24-6 18-26 24-60 24z" fill="#b9aa93" opacity=".6" />
          <path d="M46 40c-4-15 0-22 4-22s14 9 20 17z" fill="#d8cbb6" />
          <path d="M134 40c4-15 0-22-4-22s-14 9-20 17z" fill="#d8cbb6" />
          <path d="M50 36c-2-8 0-12 2-12s7 5 11 10z" fill="#e5a795" />
          <path d="M130 36c2-8 0-12-2-12s-7 5-11 10z" fill="#e5a795" />
          <ellipse cx="90" cy="112" rx="30" ry="12" fill="#e6dbc9" />
          <path d="M68 68c3 4 10 4 13 0" stroke="#574636" stroke-width="2.6" fill="none" stroke-linecap="round" />
          <path d="M99 68c3 4 10 4 13 0" stroke="#574636" stroke-width="2.6" fill="none" stroke-linecap="round" />
          <ellipse cx="62" cy="80" rx="7" ry="4.5" fill="#e5a795" opacity=".6" />
          <ellipse cx="118" cy="80" rx="7" ry="4.5" fill="#e5a795" opacity=".6" />
          <path d="M90 78l-4 4h8z" fill="#c98878" />
          <path d="M84 86c2 3 10 3 12 0" stroke="#574636" stroke-width="2.2" fill="none" stroke-linecap="round" />
        </g>
      </svg>
    </div>
    <div class="wrap">© {new Date().getFullYear()} Diego Treviño · {t.footer}</div>
  </footer>
</LayoutFlat>
