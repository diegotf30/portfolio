---
import LayoutFlat from '../layouts/LayoutFlat.astro';
import { content, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const home = lang === 'es' ? '/es/b/' : '/b/';
---

<LayoutFlat lang={lang}>
  <nav class="nav">
    <div class="wrap nav-inner">
      <a class="nav-brand" href={home}>diego<span>.tf</span></a>
      <div class="nav-links">
        <a href="#work">{t.nav.work}</a>
        <a href="#about">{t.nav.about}</a>
        <a href="#experience">{t.nav.experience}</a>
        <a href="#contact">{t.nav.contact}</a>
      </div>
      <div class="lang">
        <a href="/b/" aria-current={lang === 'en'} hreflang="en">EN</a>
        <a href="/es/b/" aria-current={lang === 'es'} hreflang="es">ES</a>
      </div>
    </div>
  </nav>

  <header class="hero">
    <!-- monstera -->
    <div class="plant p1" aria-hidden="true">
      <svg viewBox="0 0 200 270">
        <path d="M100 268V44" stroke="currentColor" stroke-width="7" fill="none" />
        <path d="M100 26C28 68 18 152 100 242 182 152 172 68 100 26Z" />
        <g stroke="var(--cream)" stroke-width="8" stroke-linecap="round" fill="none">
          <path d="M95 74H44" />
          <path d="M95 112H30" />
          <path d="M95 150H33" />
          <path d="M95 188H50" />
          <path d="M105 74h51" />
          <path d="M105 112h65" />
          <path d="M105 150h62" />
          <path d="M105 188h45" />
        </g>
      </svg>
    </div>
    <!-- fern -->
    <div class="plant p2" aria-hidden="true">
      <svg viewBox="0 0 120 240">
        <path d="M58 240c0-70 2-140 8-210 2 70 0 140-2 210z" />
        <g opacity=".85">
          <path d="M62 44c10-12 24-19 40-20-12 9-20 22-24 36-8-4-13-9-16-16z" />
          <path d="M60 78c11-13 26-21 43-22-13 10-22 24-26 39-8-4-14-10-17-17z" />
          <path d="M58 114c11-13 27-21 44-22-13 10-22 24-27 40-8-5-14-11-17-18z" />
          <path d="M56 152c11-13 27-22 45-23-14 11-23 25-28 41-8-5-14-11-17-18z" />
          <path d="M58 44C48 32 34 25 18 24c12 9 20 22 24 36 8-4 13-9 16-16z" />
          <path d="M60 78C49 65 34 57 17 56c13 10 22 24 26 39 8-4 14-10 17-17z" />
          <path d="M62 114c-11-13-27-21-44-22 13 10 22 24 27 40 8-5 14-11 17-18z" />
          <path d="M64 152c-11-13-27-22-45-23 14 11 23 25 28 41 8-5 14-11 17-18z" />
        </g>
      </svg>
    </div>

    <div class="wrap hero-copy">
      <div class="badge">
        <span class="dot"></span>
        {t.hero.badge}
      </div>
      <h1>
        {t.hero.title.map((line) => (
          <span class="line"><span>{line}</span></span>
        ))}
      </h1>
      <p class="hero-role reveal">{t.hero.role}</p>
      <p class="hero-lede reveal" style="--d:.06s">{t.hero.lede}</p>
      <p class="hero-meta reveal" style="--d:.12s">{t.hero.location}</p>
      <div class="hero-cta reveal" style="--d:.18s">
        <a class="btn btn-primary" href="#work">
          {t.hero.cta}<span class="arrow">→</span>
        </a>
        <a class="btn btn-ghost" href={`mailto:${t.contact.email}`}>{t.hero.ctaAlt}</a>
      </div>
    </div>
  </header>

  <section style="padding-top:0">
    <div class="wrap stats">
      {t.stats.map((s, i) => (
        <div class="stat reveal" style={`--d:${i * 0.07}s`}>
          <div class="v">{s.value}</div>
          <div class="l">{s.label}</div>
          <div class="n">{s.note}</div>
        </div>
      ))}
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="reveal">
        <div class="kicker">{t.work.kicker}</div>
        <h2 class="section-title">{t.work.title}</h2>
      </div>
      <div class="work-grid">
        {t.work.items.map((p, i) => (
          <article class="card reveal" style={`--d:${(i % 2) * 0.09}s`}>
            <div class="card-top">
              <span>{p.type}</span>
              <span>{p.year}</span>
            </div>
            <h3>{p.name}</h3>
            <p>{p.summary}</p>
            {p.link && (
              <a class="card-link" href={p.link} target="_blank" rel="noopener noreferrer">
                {p.linkLabel}<span class="arrow">↗</span>
              </a>
            )}
            <div class="tags">
              {p.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <div class="reveal">
        <div class="kicker">{t.about.kicker}</div>
        <h2 class="section-title">{t.about.title}</h2>
      </div>
      <div class="about-grid">
        <div class="prose reveal">
          {t.about.body.map((para) => (
            <p>{para}</p>
          ))}
        </div>
        <div class="skills reveal" style="--d:.09s">
          <h3>{t.about.skills.title}</h3>
          {t.about.skills.groups.map((g) => (
            <div class="skill-group">
              <div>{g.label}</div>
              <div class="tags" style="margin-top:0;padding-top:0">
                {g.items.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="wrap">
      <div class="reveal">
        <div class="kicker">{t.experience.kicker}</div>
        <h2 class="section-title">{t.experience.title}</h2>
      </div>
      <div class="timeline">
        {t.experience.items.map((job) => (
          <article class="job reveal">
            <div class="job-head">
              <h3>{job.role}</h3>
              <div class="org">{job.org}</div>
              <div class="period">{job.period} · {job.place}</div>
            </div>
            <ul>
              {job.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </article>
        ))}
        <div class="edu reveal">
          <div class="t">{t.experience.education.title}</div>
          <div class="d">{t.experience.education.degree}</div>
          <div class="s">{t.experience.education.school}</div>
          <div class="m">{t.experience.education.detail}</div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <div class="contact-card reveal">
        <div class="plant p3" aria-hidden="true">
          <svg viewBox="0 0 120 240">
            <path d="M58 240c0-70 2-140 8-210 2 70 0 140-2 210z" />
            <g opacity=".85">
              <path d="M62 60c10-12 24-19 40-20-12 9-20 22-24 36-8-4-13-9-16-16z" />
              <path d="M60 100c11-13 26-21 43-22-13 10-22 24-26 39-8-4-14-10-17-17z" />
              <path d="M58 60C48 48 34 41 18 40c12 9 20 22 24 36 8-4 13-9 16-16z" />
              <path d="M60 100C49 87 34 79 17 78c13 10 22 24 26 39 8-4 14-10 17-17z" />
            </g>
          </svg>
        </div>
        <div class="kicker">{t.contact.kicker}</div>
        <h2>{t.contact.title}</h2>
        <p>{t.contact.body}</p>
        <a class="mail" href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
        <div class="social">
          {t.contact.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap">© {new Date().getFullYear()} Diego Treviño · {t.footer}</div>
  </footer>
</LayoutFlat>
