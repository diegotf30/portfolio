---
import '../styles/global.css';
import { content, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const canonical = new URL(lang === 'es' ? '/es/' : '/', Astro.site);

// falling cubes: left %, size px, fall duration s, negative delay s, opacity
const rain = [
  [2, 28, 24, -3, 0.5], [7, 14, 38, -21, 0.26], [12, 34, 20, -9, 0.46],
  [16, 18, 33, -14, 0.3], [21, 23, 27, -6, 0.42], [25, 12, 41, -30, 0.24],
  [30, 31, 22, -17, 0.48], [34, 16, 36, -2, 0.28], [39, 25, 26, -25, 0.44],
  [43, 13, 39, -11, 0.25], [48, 29, 23, -34, 0.47], [52, 19, 32, -7, 0.31],
  [57, 22, 28, -19, 0.4], [61, 15, 37, -27, 0.27], [66, 33, 21, -13, 0.46],
  [70, 17, 35, -4, 0.29], [75, 26, 25, -23, 0.43], [79, 12, 40, -16, 0.24],
  [84, 30, 22, -31, 0.47], [88, 20, 31, -8, 0.33], [92, 24, 27, -20, 0.41],
  [96, 15, 36, -12, 0.27], [9, 21, 29, -37, 0.38], [45, 35, 19, -1, 0.5],
  [63, 11, 43, -33, 0.22], [82, 27, 24, -28, 0.44],
  // a second, mostly smaller and fainter pass — depth without extra noise
  [4, 10, 45, -15, 0.2], [14, 24, 26, -35, 0.4], [19, 13, 42, -5, 0.23],
  [27, 18, 34, -22, 0.3], [32, 9, 47, -40, 0.18], [36, 27, 23, -11, 0.43],
  [41, 14, 38, -29, 0.26], [50, 20, 30, -18, 0.34], [55, 32, 21, -2, 0.47],
  [59, 12, 44, -26, 0.21], [68, 23, 28, -38, 0.39], [72, 16, 35, -9, 0.28],
  [77, 10, 46, -32, 0.19], [86, 25, 26, -24, 0.42], [90, 13, 41, -6, 0.24],
  [94, 29, 23, -36, 0.45], [99, 17, 33, -14, 0.29], [1, 21, 31, -27, 0.36],
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <meta name="theme-color" content="#05070d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%2305070d'/%3E%3Ctext x='50' y='71' font-size='62' font-family='-apple-system,system-ui,sans-serif' font-weight='600' fill='%2378acff' text-anchor='middle'%3ED%3C/text%3E%3C/svg%3E"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="aurora"><span></span><span></span><span></span></div>
    <div class="dots"></div>
    <div class="cube-rain" aria-hidden="true">
      {rain.map(([l, size, dur, delay, op]) => (
        <span
          class="mini"
          style={`--l:${l}%;--s:${size}px;--d:${dur}s;--dl:${delay}s;--o:${op}`}
        >
          <span class="mini-cube"><i></i><i></i><i></i><i></i><i></i><i></i></span>
        </span>
      ))}
    </div>
    <div class="grain"></div>
    <slot />

    <script>
      // reveal on scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -12% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // pointer-tracked specular highlight on glass surfaces
      document.querySelectorAll<HTMLElement>('.glass').forEach((el) => {
        el.addEventListener('pointermove', (ev) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${ev.clientX - r.left}px`);
          el.style.setProperty('--my', `${ev.clientY - r.top}px`);
        });
      });

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // terminal typewriter
      const term = document.getElementById('term');
      if (term && !reduced) {
        const lines: [string, string][] = [
          ['whoami', 'diego treviño — software engineer'],
          ['stack --top', 'c++20 · rails · postgres · k8s'],
          ['ls projects/', 'renovacreto  lab404  zanzibar  llvm-reduce'],
          ['status', 'available for work → hola@diego.tf'],
        ];
        const caret = '<span class="caret">|</span>';
        let out = '';
        let li = 0;
        let ci = 0;
        let typing = '';

        const tick = () => {
          const [cmd, res] = lines[li];
          if (ci <= cmd.length) {
            typing = `<span class="p">$ </span>${cmd.slice(0, ci)}`;
            term.innerHTML = out + typing + caret;
            ci++;
            setTimeout(tick, 55);
          } else {
            out += `<span class="p">$ </span>${cmd}\n<span class="o">${res}</span>\n`;
            term.innerHTML = out + caret;
            li++;
            ci = 0;
            if (li < lines.length) {
              setTimeout(tick, 620);
            } else {
              setTimeout(() => {
                out = '';
                li = 0;
                tick();
              }, 3400);
            }
          }
        };
        tick();
      } else if (term) {
        term.textContent = '$ whoami\ndiego treviño — software engineer';
      }
    </script>
  </body>
</html>
