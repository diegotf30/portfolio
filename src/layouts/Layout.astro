---
import '../styles/global.css';
import { content, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const canonical = new URL(lang === 'es' ? '/es/' : '/', Astro.site);

// falling cubes: left %, size px, fall duration s, negative delay s, opacity
const rain = [
  [4, 26, 26, -3, 0.5], [13, 15, 34, -14, 0.34], [21, 34, 21, -8, 0.42],
  [30, 19, 30, -19, 0.3], [39, 24, 24, -5, 0.46], [47, 13, 37, -22, 0.28],
  [56, 30, 23, -11, 0.4], [64, 17, 32, -1, 0.32], [72, 22, 27, -16, 0.44],
  [80, 15, 35, -7, 0.3], [88, 28, 22, -20, 0.4], [95, 18, 31, -12, 0.33],
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <meta name="theme-color" content="#05070d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%2305070d'/%3E%3Ctext x='50' y='71' font-size='62' font-family='-apple-system,system-ui,sans-serif' font-weight='600' fill='%2378acff' text-anchor='middle'%3ED%3C/text%3E%3C/svg%3E"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="aurora"><span></span><span></span><span></span></div>
    <div class="dots"></div>
    <div class="cube-rain" aria-hidden="true">
      {rain.map(([l, size, dur, delay, op]) => (
        <span
          class="mini"
          style={`--l:${l}%;--s:${size}px;--d:${dur}s;--dl:${delay}s;--o:${op}`}
        >
          <span class="mini-cube"><i></i><i></i><i></i><i></i><i></i><i></i></span>
        </span>
      ))}
    </div>
    <div class="shards" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="grain"></div>
    <slot />

    <script>
      // reveal on scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -12% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // pointer-tracked specular highlight on glass surfaces
      document.querySelectorAll<HTMLElement>('.glass').forEach((el) => {
        el.addEventListener('pointermove', (ev) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${ev.clientX - r.left}px`);
          el.style.setProperty('--my', `${ev.clientY - r.top}px`);
        });
      });

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // terminal typewriter
      const term = document.getElementById('term');
      if (term && !reduced) {
        const lines: [string, string][] = [
          ['whoami', 'diego treviño — software engineer'],
          ['stack --top', 'c++20 · rails · postgres · k8s'],
          ['ls projects/', 'renovacreto  lab404  zanzibar  llvm-reduce'],
          ['status', 'available for work → hola@diego.tf'],
        ];
        const caret = '<span class="caret">|</span>';
        let out = '';
        let li = 0;
        let ci = 0;
        let typing = '';

        const tick = () => {
          const [cmd, res] = lines[li];
          if (ci <= cmd.length) {
            typing = `<span class="p">$ </span>${cmd.slice(0, ci)}`;
            term.innerHTML = out + typing + caret;
            ci++;
            setTimeout(tick, 55);
          } else {
            out += `<span class="p">$ </span>${cmd}\n<span class="o">${res}</span>\n`;
            term.innerHTML = out + caret;
            li++;
            ci = 0;
            if (li < lines.length) {
              setTimeout(tick, 620);
            } else {
              setTimeout(() => {
                out = '';
                li = 0;
                tick();
              }, 3400);
            }
          }
        };
        tick();
      } else if (term) {
        term.textContent = '$ whoami\ndiego treviño — software engineer';
      }
    </script>
  </body>
</html>
