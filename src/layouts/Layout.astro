---
import '../styles/global.css';
import { content, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const canonical = new URL(lang === 'es' ? '/es/' : '/', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <meta name="theme-color" content="#05070d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%2305070d'/%3E%3Ctext x='50' y='71' font-size='62' font-family='-apple-system,system-ui,sans-serif' font-weight='600' fill='%2378acff' text-anchor='middle'%3ED%3C/text%3E%3C/svg%3E"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="aurora"><span></span><span></span><span></span></div>
    <div class="dots"></div>
    <div class="shards" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="grain"></div>
    <slot />

    <script>
      // reveal on scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -12% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // pointer-tracked specular highlight on glass surfaces
      document.querySelectorAll<HTMLElement>('.glass').forEach((el) => {
        el.addEventListener('pointermove', (ev) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${ev.clientX - r.left}px`);
          el.style.setProperty('--my', `${ev.clientY - r.top}px`);
        });
      });

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // parallax: one scroll var, CSS moves the layers at different rates
      if (!reduced) {
        const root = document.documentElement;
        addEventListener(
          'scroll',
          () => root.style.setProperty('--sy', String(scrollY)),
          { passive: true }
        );
      }

      // drag the cube to spin it; release and the idle tumble carries on
      const stage = document.querySelector<HTMLElement>('.cube-stage');
      const tilt = document.querySelector<HTMLElement>('.cube-tilt');
      if (stage && tilt) {
        let rx = 0;
        let ry = 0;
        let dragging = false;
        let dragged = false;
        let lastX = 0;
        let lastY = 0;

        const apply = () => {
          tilt.style.setProperty('--px', `${rx}deg`);
          tilt.style.setProperty('--py', `${ry}deg`);
        };

        stage.addEventListener('pointerdown', (e) => {
          dragging = true;
          lastX = e.clientX;
          lastY = e.clientY;
          tilt.classList.add('dragging');
          stage.setPointerCapture(e.pointerId);
        });

        stage.addEventListener('pointermove', (e) => {
          if (dragging) {
            dragged = true;
            ry += (e.clientX - lastX) * 0.6;
            rx -= (e.clientY - lastY) * 0.6;
            lastX = e.clientX;
            lastY = e.clientY;
            apply();
            return;
          }
          // once it has been dragged, the orientation is the visitor's; leave it
          if (dragged) return;
          // idle hover: lean toward the cursor, capped so it stays legible
          const r = stage.getBoundingClientRect();
          ry = ((e.clientX - (r.left + r.width / 2)) / r.width) * 26;
          rx = -((e.clientY - (r.top + r.height / 2)) / r.height) * 26;
          apply();
        });

        const release = () => {
          dragging = false;
          tilt.classList.remove('dragging');
        };
        stage.addEventListener('pointerup', release);
        stage.addEventListener('pointercancel', release);
        stage.addEventListener('pointerleave', () => {
          if (!dragging && !dragged) {
            rx = 0;
            ry = 0;
            apply();
          }
        });
      }

      // terminal typewriter
      const term = document.getElementById('term');
      if (term && !reduced) {
        const lines: [string, string][] = [
          ['whoami', 'diego treviño — software engineer'],
          ['stack --top', 'c++20 · rails · postgres · k8s'],
          ['status', 'available for work → hola@diego.tf'],
        ];
        const caret = '<span class="caret">|</span>';
        let out = '';
        let li = 0;
        let ci = 0;
        let typing = '';

        const tick = () => {
          const [cmd, res] = lines[li];
          if (ci <= cmd.length) {
            typing = `<span class="p">$ </span>${cmd.slice(0, ci)}`;
            term.innerHTML = out + typing + caret;
            ci++;
            setTimeout(tick, 55);
          } else {
            out += `<span class="p">$ </span>${cmd}\n<span class="o">${res}</span>\n`;
            term.innerHTML = out + caret;
            li++;
            ci = 0;
            if (li < lines.length) {
              setTimeout(tick, 620);
            } else {
              setTimeout(() => {
                out = '';
                li = 0;
                tick();
              }, 3400);
            }
          }
        };
        tick();
      } else if (term) {
        term.textContent = '$ whoami\ndiego treviño — software engineer';
      }
    </script>
  </body>
</html>
